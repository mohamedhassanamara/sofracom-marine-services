rules_version = '2';

// All writes go through the Next.js API routes (Admin SDK), which bypass these rules.
// Clients may only read: their own profile, addresses, orders and quotes; published
// reviews; and product rating stats. Staff (admin claim, and for app devices an active
// devices/{id} doc) can read all. devices, enrollCodes and logs are server-only.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Staff are either website accounts with the admin claim, or enrolled staff-app
    // devices (custom tokens with device == true) whose devices/{id} doc is still active.
    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && (request.auth.token.get('device', false) != true || deviceActive());
    }

    function deviceActive() {
      let path = /databases/$(database)/documents/devices/$(request.auth.token.deviceId);
      return exists(path) && get(path).data.active == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /addresses/{addressId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /quotes/{quoteId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /productStats/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
